{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "e.g. 2021-03"
    },
    "money": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "Decimal amount as a string with exactly 2 places; never a JSON number"
    }
  }
}
